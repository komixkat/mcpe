+                    uint64_t* c = (uint64_t*)control;
+                    if (c[0] >= 0x10000000ULL && c[1] >= 0x10000000ULL) {
+                        c[0] = 8;
+                        c[1] = 8;
+                        c[2] = 0;
+                        c[3] = 0;
+                    }
+                    typedef void* (*emutls_fn_t)(void*);
+                    return ((emutls_fn_t)g_tramp)(control);
+                };
